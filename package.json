{
  "name": "guitar-tuner",
  "private": true,
  "version": "0.1.9",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --grep-invert @exploration",
    "test:e2e:ui": "playwright test --grep-invert @exploration --ui",
    "test:e2e:explore": "playwright test --grep @exploration",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:e2e": "npm run build && vite preview --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "oxlint": "^1.94.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.1.1"
  }
}
